# clusters/@@CLUSTER@@/agents/identity/cluster-admin-identity.yaml
#
# Rendered by the propose-cluster-admin skill (F4 cascade). The APPLIED per-cluster read-only identity
# for @@CLUSTER@@'s cluster-admin agent — SA + read-only ClusterRole + ClusterRoleBinding + Workload-
# Identity annotation. The kube-agents controller REFERENCES the ServiceAccount by name
# (spec.security.serviceAccountName) and mints no RBAC at runtime (08 §4).
#
# This is a flat manifest (not a kustomize overlay) because the reference actuation pipeline applies
# clusters/<c>/agents/ with `kubectl apply --server-side --recursive -f` — a kustomization.yaml here
# would break that recursive apply. It is the materialized instance of the tier exemplar at
# policy/rbac-overlay/cluster-admin.yaml (the canonical shape + VAP test fixture); keep them in sync
# when the tier's read-only shape changes.
#
# APPLY ORDER: this identity is applied BEFORE ../agent.yaml (identity-before-pod invariant) and AFTER
# the VAP (so a write-verb/wrong-scope grant is rejected even during provisioning). The bootstrap apply
# waves (clusters/@@CLUSTER@@/bootstrap/) enforce the order; within the agents apply the read-only
# identity below is VAP-clean, so recursive apply admits it regardless of file order.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: cluster-admin-agent
  namespace: kubeagents-system
  labels:
    kube-agents/tier: cluster-admin
    app.kubernetes.io/managed-by: gitops
  annotations:
    # Workload Identity: binds this KSA to the VIEWER-ONLY cloud GSA (06 §2). The GSA holds only viewer
    # cloud IAM — the cloud-write path is a reviewed GitOps PR, never the agent process.
    #
    # NOTE (per-cluster scoping — flagged for the human before production): a single project-level GSA
    # reads every cluster in the project. For a project running MORE THAN ONE cluster-admin agent, this
    # GSA must become per-cluster (distinct GSA or an IAM Condition on the cluster resource) so "reads
    # only its own cluster" (acceptance b) holds in the cloud too.
    iam.gke.io/gcp-service-account: "kubeagents-cluster-admin-gsa@@@PROJECT_ID@@.iam.gserviceaccount.com"
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: cluster-admin-agent-explorer
  labels:
    kube-agents/tier: cluster-admin
rules:
  - apiGroups:
      ["", "apps", "batch", "networking.k8s.io", "rbac.authorization.k8s.io"]
    resources: ["*"]
    verbs: ["get", "list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: cluster-admin-agent-explorer
  labels:
    kube-agents/tier: cluster-admin
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: cluster-admin-agent-explorer
subjects:
  - kind: ServiceAccount
    name: cluster-admin-agent
    namespace: kubeagents-system
