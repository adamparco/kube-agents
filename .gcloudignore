# Version control
.git
.github

# IDEs and AI agent logs/scratch files
.idea/
.vscode/
.gemini/
# Claude Code keeps session transcripts and git worktrees here. The worktrees
# are full repository checkouts, so an unignored .claude/ turns a ~240M upload
# into a ~930M one -- and the worktrees carry their own .git, which the
# `.git` line above does not match at that depth.
.claude/
.DS_Store
Thumbs.db

# Build and package caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
node_modules/
.venv/
venv/
k8s-operator/bin/
# `terraform init` writes provider plugins here -- 436M across
# `examples/full-install` and `modules/kube-agents-iam` on a tree that has run
# the installer. `.gitignore` already covers it, but gcloud reads `.gitignore`
# only when no `.gcloudignore` exists, so it has to be repeated. Left out, the
# source upload grows from ~50M to ~490M, which is enough to make the
# Enterprise Certificate Proxy fail every `gcloud builds submit` with
# "Failed to forward request" while short API reads keep working.
.terraform/
*.tfstate
*.tfstate.*

# Local configuration files (except tracked default .env)
.env
.env.*
!agents/shared/defaults/.env
**/vars.sh
# The hand-authored install configuration. It holds credentials, and the
# patterns above do not reach it: they anchor on a leading dot.
install.env
**/install.env
