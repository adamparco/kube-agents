# Base image pin: the Hermes agent image every first-party agent image is built FROM.
HERMES_AGENT_TAG=v2026.7.20@sha256:a6ce64e2038867885c2c90f6602425e6e70293d5e6d952a0e603a99265e01c40

# The version this tree publishes its own images under. Single source of truth: every manifest,
# kustomization and Makefile default that pins a first-party image pins THIS tag, and
# local-dev/test_image_provenance.py (V-CMP-002) fails if any of them drifts from it.
#
# It is produced by pushing a matching git tag, NOT by pushing to main. That is what makes it
# immutable, which is what the six "pinned to an immutable version tag" comments across the tree
# have always claimed and never had: a push to main publishes :${git-sha} and nothing else, so
# v0.1.0 is written exactly once, when the v0.1.0 tag is cut. Bumping = change this line, then tag.
# The publish workflows refuse a tag build whose git tag does not match this value.
KAGE_IMAGE_VERSION=v0.1.0
