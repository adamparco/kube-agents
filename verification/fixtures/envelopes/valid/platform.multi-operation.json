{
  "apiVersion": "kubeagents.x-k8s.io/v1alpha1",
  "kind": "ActionEnvelope",
  "intent": "drain the deprecated worker pool and scale the replacement up",
  "rationale": "The v1 pool is cordoned; the v2 pool has capacity for the shifted load.",
  "operations": [
    {
