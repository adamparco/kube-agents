# Developer Team Agent (tier 3): namespace, read-only AUTHORITY, and Agent CR for one tenant.
#
# Rendered by provision_12_deploy_agent_tiers.sh, which applies this tenant's reader/actor
# ServiceAccounts from `agent-identity.yaml.template` first — see the header of
# cluster-admin-agent.yaml.template for why the identity no longer lives inline here. What remains
# is the tenant boundary and this tier's authority within it.
apiVersion: v1
kind: Namespace
metadata:
  name: ${DEVELOPER_TEAM_NAMESPACE}
  labels:
    kube-agents/tenant: ${DEVELOPER_TEAM_NAMESPACE}
    # Agent pods are rendered hardened; enforce that at the namespace boundary too.
    pod-security.kubernetes.io/enforce: restricted
    pod-security.kubernetes.io/enforce-version: latest
---
# A namespaced Role, deliberately NOT a ClusterRole: the tenant boundary is structural, so the
# agent cannot read another team's namespace even if it tried.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: ${DEVELOPER_TEAM_KSA_NAME}-explorer
  namespace: ${DEVELOPER_TEAM_NAMESPACE}
  labels:
    kube-agents/tier: developer-team
    kube-agents/role: reader
rules:
  - apiGroups: ["", "apps", "batch", "networking.k8s.io"]
    resources: ["*"]
    verbs: ["get", "list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: ${DEVELOPER_TEAM_KSA_NAME}-explorer
  namespace: ${DEVELOPER_TEAM_NAMESPACE}
  labels:
    kube-agents/tier: developer-team
    kube-agents/role: reader
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: ${DEVELOPER_TEAM_KSA_NAME}-explorer
subjects:
  - kind: ServiceAccount
    name: ${DEVELOPER_TEAM_KSA_NAME}
    namespace: ${DEVELOPER_TEAM_NAMESPACE}
---
apiVersion: kubeagents.x-k8s.io/v1alpha1
kind: Agent
metadata:
  # PLACEMENT (A1): metadata.namespace MUST equal spec.scope.namespace or the admission webhook
  # rejects the CR. This is what keeps the agent pod inside the tenant's isolation controls.
  name: ${DEVELOPER_TEAM_AGENT_NAME}
  namespace: ${DEVELOPER_TEAM_NAMESPACE}
  labels:
    kube-agents/tier: developer-team
spec:
  tier: developer-team
  scope:
    projectId: "${PROJECT_ID}"
    clusterName: "${CLUSTER_NAME}"
    namespace: "${DEVELOPER_TEAM_NAMESPACE}"
  parentRef:
    name: ${CLUSTER_ADMIN_AGENT_NAME}
  iac:
    format: kcc
  deployment:
    # Pin explicitly; see the note in cluster-admin-agent.yaml.template.
    image: "${DEVELOPER_TEAM_IMAGE}"
    tag: "${DEVELOPER_TEAM_TAG}"
    imagePullPolicy: "IfNotPresent"
  harness:
    clusterName: "${CLUSTER_NAME}"
    location: "${REGION}"
    hermes:
      dashboardEnabled: true
      apiServerSecretRef:
        name: ${DEVELOPER_TEAM_KSA_NAME}-secrets
        key: API_SERVER_KEY
  security:
    serviceAccountName: ${DEVELOPER_TEAM_KSA_NAME}
  integration:
    googleChat:
      enabled: ${DEVELOPER_TEAM_GOOGLE_CHAT_ENABLED}
${DEVELOPER_TEAM_ALLOWED_USERS_BLOCK}
    slack:
      enabled: ${DEVELOPER_TEAM_SLACK_ENABLED}
${DEVELOPER_TEAM_SLACK_ALLOWED_USERS_BLOCK}
