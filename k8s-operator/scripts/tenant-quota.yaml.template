# tenant-quota.yaml.template
#
# Blast-radius bound for a tenant namespace (03 §3 isolation; Phase 3), rendered by
# `provision_12_deploy_agent_tiers.sh` and applied by it BEFORE the agent pod is created. The
# committed exemplar under examples/gitops-repo/ is the REFERENCE RENDER of this template,
# byte-for-byte, and local-dev/tests/reference-render.py fails if they drift — edit this file, then
# regenerate it.
#
# A ResourceQuota caps the aggregate compute + object footprint of EVERYTHING in the namespace — the
# Developer Team Agent pod AND the tenant's own workloads — so a runaway rollout (or a compromised or
# looping agent) cannot starve the cluster or other tenants. The cluster-admin tier proposes this
# alongside the namespace and the default-deny NetworkPolicy (propose-developer-team cascade); a human
# reviews and merges; CI/CD applies it.
#
# WHY THIS IS APPLIED BEFORE THE AGENT POD, NOT AFTER. Once a quota sets `requests.*`/`limits.*`, every
# pod in the namespace MUST declare requests+limits or admission rejects it. Applying the quota first
# means a mis-sized agent fails loudly during install, on the step that created it. Applying it after
# means the install goes green and the namespace is left holding a trap that springs on some later
# rollout, in front of whoever triggered it rather than whoever caused it. The controller stamps
# requests+limits on all four agent containers, so the rendered pod satisfies this — the ordering is
# what keeps that true rather than merely true today.
#
# The compute bounds and the pod cap are the per-tenant knobs (see common.sh for the defaults). The
# remaining object counts are namespace hygiene rather than blast-radius controls and are fixed here.
apiVersion: v1
kind: ResourceQuota
metadata:
  name: ${TENANT_QUOTA_NAME}
  namespace: ${TENANT_NAMESPACE}
  labels:
    kube-agents/tenant: ${TENANT_NAMESPACE}
    app.kubernetes.io/managed-by: gitops
spec:
  hard:
    requests.cpu: "${TENANT_QUOTA_REQUESTS_CPU}"
    requests.memory: ${TENANT_QUOTA_REQUESTS_MEMORY}
    limits.cpu: "${TENANT_QUOTA_LIMITS_CPU}"
    limits.memory: ${TENANT_QUOTA_LIMITS_MEMORY}
    pods: "${TENANT_QUOTA_PODS}"
    services: "20"
    count/configmaps: "50"
    count/secrets: "50"
    persistentvolumeclaims: "20"
