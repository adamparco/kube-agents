apiVersion: kubeagents.x-k8s.io/v1alpha1
kind: Agent
metadata:
  name: platform-agent
  namespace: "${NAMESPACE}"
  labels:
    kube-agents/tier: platform
spec:
  # Persona / containment level (06 §1.1). Immutable after creation.
  tier: platform
  # Admission requires no scope of the platform tier (06 §1.2 V-2) and this used to be omitted
  # entirely. It cannot be, once the tier has a broker. The actor identity's name is
  # `<tier>-<scope-leaf>-actor` and the leaf of a scope-less platform agent is the empty string, so
  # the controller renders `platform--actor` while the broker's own validate() refuses to start with
  # an empty --scope: the pair comes up BrokerReady=false and stays there. `projectId` is the
  # conventional platform scope (agent_webhook.go:384 says so), it makes the leaf well defined, and
  # it strictly contains every cluster-admin scope beneath it, which is what V-6's parent ceiling
  # asks for. Scope is mutable — only `tier` is not — so this applies cleanly to an existing CR.
  scope:
    projectId: "${PROJECT_ID}"
  harness:
    clusterName: "${CLUSTER_NAME}"
    location: "${REGION}"
    hermes:
      dashboardEnabled: true
      pluginsDebug: false
      agentHome: "/opt/data"
      apiServerSecretRef:
        name: platform-agent-secrets
        key: API_SERVER_KEY
    memory:
      memoryEnabled: ${MEMORY_ENABLED}
      provider: "${MEMORY_PROVIDER}"
      userProfileEnabled: ${USER_PROFILE_ENABLED}
  deployment:
    # runtimeClassName: gvisor # Uncomment to enable GKE Sandbox (gVisor) kernel isolation
    image: "${AGENT_IMAGE}"
    tag: "${AGENT_TAG}"
    imagePullPolicy: Always
  security:
    serviceAccountName: "${KSA_NAME}"
    serviceAccountAnnotations:
      iam.gke.io/gcp-service-account: "${GSA_NAME}@${PROJECT_ID}.iam.gserviceaccount.com"
  integration:
    github:
      gitRepo: "${GITHUB_FULL_REPO}"
    googleChat:
      enabled: ${GOOGLE_CHAT_ENABLED}
      mode: "${GOOGLE_CHAT_MODE}"
      projectId: "${PROJECT_ID}"
      topicName: "${CHAT_TOPIC_NAME}"
      subscriptionName: "${CHAT_SUB_NAME}"
${ALLOWED_USERS_BLOCK}
      homeChannel: ""
    slack:
      enabled: ${SLACK_ENABLED}
      botTokenSecretRef:
        name: platform-agent-secrets
        key: SLACK_BOT_TOKEN
      appTokenSecretRef:
        name: platform-agent-secrets
        key: SLACK_APP_TOKEN
${SLACK_ALLOWED_USERS_BLOCK}
      homeChannel: "${SLACK_HOME_CHANNEL}"
      homeChannelName: "${SLACK_HOME_CHANNEL_NAME}"
