# Cluster Admin Agent (tier 2): read-only AUTHORITY + Agent CR for one cluster.
#
# Rendered by provision_12_deploy_agent_tiers.sh. The identity is applied before the CR
# (identity-before-pod): the controller REFERENCES the ServiceAccount by name and never mints
# RBAC or a KSA itself (08 §4).
#
# THE SERVICEACCOUNTS ARE NOT IN THIS FILE. They used to be — one reader SA, written inline here and
# again in developer-team-agent.yaml.template, with the platform reader written nowhere and no actor
# identity anywhere. They come from `agent-identity.yaml.template` now, applied by
# `apply_agent_identity` in the step above, so that all three tiers get identical labels and the
# actor half arrives with the reader half. What stays here is the tier's AUTHORITY — what this agent
# may read — which genuinely differs per tier and is the reason the two concerns were ever separable.
#
# Read verbs only. The kube-agents-agent-readonly ValidatingAdmissionPolicy rejects any
# tier-labelled role carrying a write or privilege-escalation verb, so this is enforced at
# admission and not merely by convention.
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: ${CLUSTER_ADMIN_KSA_NAME}-explorer
  labels:
    kube-agents/tier: cluster-admin
    kube-agents/role: reader
rules:
  - apiGroups:
      ["", "apps", "batch", "networking.k8s.io", "rbac.authorization.k8s.io"]
    resources: ["*"]
    verbs: ["get", "list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: ${CLUSTER_ADMIN_KSA_NAME}-explorer
  labels:
    kube-agents/tier: cluster-admin
    kube-agents/role: reader
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: ${CLUSTER_ADMIN_KSA_NAME}-explorer
subjects:
  - kind: ServiceAccount
    name: ${CLUSTER_ADMIN_KSA_NAME}
    namespace: ${NAMESPACE}
---
apiVersion: kubeagents.x-k8s.io/v1alpha1
kind: Agent
metadata:
  name: ${CLUSTER_ADMIN_AGENT_NAME}
  namespace: ${NAMESPACE}
  labels:
    kube-agents/tier: cluster-admin
spec:
  tier: cluster-admin
  # project + cluster form the (tier,scope) uniqueness key the admission webhook enforces:
  # one cluster-admin agent per cluster.
  scope:
    projectId: "${PROJECT_ID}"
    clusterName: "${CLUSTER_NAME}"
  # Non-platform tiers must name their parent.
  parentRef:
    name: platform-agent
  iac:
    format: kcc
  deployment:
    # Pin explicitly. Omitting this makes the controller fall back to the per-tier default baked
    # into the binary (ghcr.io/gke-labs/...), which is NOT your source-built image.
    image: "${CLUSTER_ADMIN_IMAGE}"
    tag: "${CLUSTER_ADMIN_TAG}"
    imagePullPolicy: "IfNotPresent"
  harness:
    clusterName: "${CLUSTER_NAME}"
    location: "${REGION}"
    hermes:
      dashboardEnabled: true
      apiServerSecretRef:
        name: ${CLUSTER_ADMIN_KSA_NAME}-secrets
        key: API_SERVER_KEY
  security:
    serviceAccountName: ${CLUSTER_ADMIN_KSA_NAME}
  integration:
    googleChat:
      enabled: ${CLUSTER_ADMIN_GOOGLE_CHAT_ENABLED}
${CLUSTER_ADMIN_ALLOWED_USERS_BLOCK}
    slack:
      enabled: ${CLUSTER_ADMIN_SLACK_ENABLED}
${CLUSTER_ADMIN_SLACK_ALLOWED_USERS_BLOCK}
