  "identities": [
    {
      "serviceAccount": "system:serviceaccount:kubeagents-system:agent-a2a-provision",
      "user": "provision",
      "account": "APP",
      "grants": {
        "publish": [
          "a2a.topics.agent.platform.upgrade-readiness",
          "a2a.topics.shared.blueprint",
          "a2a.topics.shared.annotations",
          "$JS.API.INFO",
          "$JS.API.STREAM.NAMES",
          "$JS.API.STREAM.LIST",
          "$JS.API.STREAM.CREATE.TASKS",
          "$JS.API.STREAM.CREATE.DIRECTORY",
